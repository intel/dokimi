{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/intel/dokimi/schemas/cli_routes.v1.json",
  "title": "CLI route table v1",
  "description": "The routes of the dokimi CLI as `dokimi data schema show cli_routes` prints them (dokimi.cli_routes.document): the help sections, every top-level command with its section, aliases and cost, every leaf operation with its cost, and the tombstones (old argv prefixes that moved). `cost` is `paid` when the route can make a model call in some flag combination, else `free`.",
  "type": "object",
  "required": ["schema_version", "sections", "roots", "leaves", "tombstones"],
  "additionalProperties": false,
  "$defs": {
    "cost": {"enum": ["free", "paid"]},
    "path": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1},
      "description": "An argv prefix, e.g. [\"eval\", \"score\"]."
    }
  },
  "properties": {
    "schema_version": {"const": "cli_routes.v1"},
    "sections": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "description": "The headings of `dokimi --help`, in order."
    },
    "roots": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "section", "aliases", "cost"],
        "additionalProperties": false,
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "section": {"type": "string", "minLength": 1, "description": "One of `sections`."},
          "aliases": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "cost": {"$ref": "#/$defs/cost", "description": "paid when any leaf under the root is paid."}
        }
      }
    },
    "leaves": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "cost"],
        "additionalProperties": false,
        "properties": {
          "path": {"$ref": "#/$defs/path"},
          "cost": {"$ref": "#/$defs/cost"}
        }
      }
    },
    "tombstones": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["old", "new"],
        "additionalProperties": false,
        "properties": {
          "old": {"$ref": "#/$defs/path"},
          "new": {"$ref": "#/$defs/path"}
        }
      }
    }
  }
}
