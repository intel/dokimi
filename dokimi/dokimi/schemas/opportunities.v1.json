{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/intel/dokimi/schemas/opportunities.v1.json",
  "title": "Ranked opportunities v1",
  "description": "A ranked queue of fixes built from stored dokimi evidence (novelty, repo_static, llms.txt findings) by `report opportunities`. Each item carries impact, effort, an impact x effort quadrant, a source_key stable across runs and an execution prompt for a coding agent.",
  "type": "object",
  "required": ["schema_version", "inputs", "items"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "opportunities.v1"},
    "run_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}(?![\\s\\S])", "description": "The envelope: the id of the run that saved this file (dokimi.artifacts.run_id). Absent from files saved before the envelope."},
    "dokimi_version": {"type": "string", "minLength": 1, "description": "The envelope: the dokimi version that saved this file. Absent from files saved before the envelope."},
    "inputs": {"type": "array", "items": {"type": "object", "required": ["path", "kind"], "properties": {
      "path": {"type": "string"}, "kind": {"enum": ["novelty", "repo_static", "llms_txt"]}}}},
    "items": {"type": "array", "items": {
      "type": "object",
      "required": ["rank", "kind", "title", "why", "next_action", "target", "impact", "effort", "quadrant", "source_key", "execution_prompt", "evidence"],
      "properties": {
        "rank": {"type": "integer", "minimum": 1},
        "kind": {"type": "string", "minLength": 1},
        "title": {"type": "string"},
        "why": {"type": "string"},
        "next_action": {"type": "string"},
        "target": {"type": "string"},
        "impact": {"type": "number", "minimum": 0, "maximum": 1},
        "effort": {"enum": ["low", "medium", "high"]},
        "quadrant": {"enum": ["act_now", "plan", "if_capacity", "deprioritize"]},
        "source_key": {"type": "string", "pattern": "^[0-9a-f]{16}$"},
        "execution_prompt": {"type": "string"},
        "evidence": {"type": "object"}
      }
    }}
  }
}
