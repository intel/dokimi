{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/intel/dokimi/schemas/answers.v1.json",
  "title": "Answers artifact v1",
  "type": "object",
  "required": [
    "answers"
  ],
  "properties": {
    "schema_version": {
      "const": "answers.v1"
    },
    "generated_at": {
      "type": "string"
    },
    "model": {
      "type": [
        "string",
        "null"
      ]
    },
    "provider": {
      "type": [
        "string",
        "null"
      ]
    },
    "total_questions": {
      "type": "integer"
    },
    "answers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "question_id"
        ],
        "properties": {
          "question_id": {
            "type": [
              "string",
              "integer"
            ]
          },
          "question_text": {
            "type": "string"
          },
          "library_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "with_docs": {
            "type": [
              "object",
              "null"
            ]
          },
          "without_docs": {
            "type": [
              "object",
              "null"
            ]
          },
          "category": {
            "description": "Copied from the question record."
          },
          "difficulty": {
            "description": "Copied from the question record."
          },
          "persona": {
            "description": "Copied from the question record."
          },
          "error": {
            "description": "Why this record has no result; present only on a failed question."
          },
          "ground_truth_chunk": {
            "description": "The documentation excerpt a chunk-grounded question was generated from."
          },
          "question_source": {
            "description": "How a chunk-grounded question was produced (e.g. chunk)."
          }
        }
      }
    },
    "token_usage_summary": {
      "description": "Prompt/completion/total tokens summed over all answers, overall and per condition."
    },
    "question_set_hash": {
      "description": "Fingerprint of the question set answered (see orchestrator.pipeline.compute_question_set_hash)."
    }
  }
}
