{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/intel/dokimi/schemas/catalog_eval.v1.json",
  "$comment": "Copyright (C) 2026 Intel Corporation; SPDX-License-Identifier: Apache-2.0",
  "title": "Catalog deterministic checks v1",
  "description": "Static input checks and planning only; evaluation states never claim measured agent behavior.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "catalog_eval.v1"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}(?![\\s\\S])",
      "description": "The envelope: the id of the run that saved this file (dokimi.artifacts.run_id). Absent from files saved before the envelope."
    },
    "dokimi_version": {
      "type": "string",
      "minLength": 1,
      "description": "The envelope: the dokimi version that saved this file. Absent from files saved before the envelope."
    },
    "tier": {
      "const": "static"
    },
    "root": {
      "type": "string"
    },
    "catalog_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "selection": {
      "type": "object",
      "properties": {
        "mode": {
          "enum": [
            "all",
            "changed"
          ]
        },
        "changed_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "selected": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reasons": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "unclaimed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "removed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "mode",
        "changed_paths",
        "selected",
        "reasons",
        "unclaimed",
        "removed"
      ],
      "additionalProperties": false
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "bundle_digest": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "checks": {
            "type": "object",
            "properties": {
              "status": {
                "enum": [
                  "pass",
                  "fail"
                ]
              },
              "findings": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "level": {
                      "enum": [
                        "error",
                        "warn",
                        "note"
                      ]
                    },
                    "code": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    },
                    "path": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "level",
                    "code",
                    "message",
                    "path"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "status",
              "findings"
            ],
            "additionalProperties": false
          },
          "evaluation": {
            "enum": [
              "checks_only",
              "no_tasks",
              "not_measured"
            ]
          },
          "evaluated_here": {
            "type": "boolean"
          },
          "tasks": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "path": {
                  "type": "string"
                },
                "digest": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "declared": {
                  "type": "boolean"
                }
              },
              "required": [
                "name",
                "path",
                "digest",
                "declared"
              ],
              "additionalProperties": false
            }
          },
          "planned_tasks": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evaluation_reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "name",
          "path",
          "bundle_digest",
          "checks",
          "evaluation",
          "evaluated_here",
          "tasks",
          "planned_tasks",
          "evaluation_reason"
        ],
        "additionalProperties": false
      }
    },
    "problems": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "level": {
            "enum": [
              "error",
              "warn",
              "note"
            ]
          },
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "path": {
            "type": "string"
          }
        },
        "required": [
          "level",
          "code",
          "message",
          "path"
        ],
        "additionalProperties": false
      }
    },
    "status": {
      "enum": [
        "pass",
        "fail"
      ]
    },
    "source": {
      "type": "object",
      "properties": {
        "commit": {
          "type": [
            "string",
            "null"
          ]
        },
        "dirty": {
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "required": [
        "commit",
        "dirty"
      ],
      "additionalProperties": false
    },
    "plan_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "generated_at": {
      "type": "string"
    },
    "selection_note": {
      "type": "string"
    },
    "checker": {
      "type": "object",
      "properties": {
        "dokimi_version": {
          "type": "string"
        },
        "python_version": {
          "type": "string"
        },
        "package_sha256": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      },
      "required": [
        "dokimi_version",
        "python_version",
        "package_sha256"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "tier",
    "root",
    "catalog_digest",
    "selection",
    "skills",
    "problems",
    "status"
  ],
  "additionalProperties": false
}
