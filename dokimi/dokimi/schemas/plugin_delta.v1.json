{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/intel/dokimi/schemas/plugin_delta.v1.json",
  "title": "Plugin delta artifact v1",
  "type": "object",
  "required": [
    "schema_version",
    "arms",
    "score_deltas",
    "cost_deltas",
    "answer_text_deltas"
  ],
  "properties": {
    "schema_version": {
      "const": "plugin_delta.v1"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "description": "The envelope: the id of the run that saved this file (dokimi.artifacts.run_id). Absent from files saved before the envelope."
    },
    "dokimi_version": {
      "type": "string",
      "minLength": 1,
      "description": "The envelope: the dokimi version that saved this file. Absent from files saved before the envelope."
    },
    "library_name": {
      "type": ["string", "null"]
    },
    "model": {
      "type": ["string", "null"]
    },
    "provider": {
      "type": ["string", "null"]
    },
    "harness": {
      "type": ["string", "null"]
    },
    "judge_model": {
      "type": ["string", "null"]
    },
    "judge_provider": {
      "type": ["string", "null"]
    },
    "baseline_plugin_set": {
      "type": ["string", "null"]
    },
    "baseline_plugin_set_id": {
      "type": ["string", "null"]
    },
    "plugin_set": {
      "type": ["string", "null"]
    },
    "plugin_set_id": {
      "type": ["string", "null"]
    },
    "arms": {
      "type": "array",
      "items": {"type": "string"}
    },
    "total_questions": {
      "type": ["integer", "null"]
    },
    "score_deltas": {
      "type": "object"
    },
    "cost_deltas": {
      "type": "object"
    },
    "answer_text_deltas": {
      "type": "object"
    },
    "warnings": {
      "type": "array",
      "items": {"type": "string"}
    }
  }
}
