{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/intel/dokimi/schemas/plugin_delta.v1.json",
  "title": "Plugin delta artifact v1",
  "type": "object",
  "required": [
    "schema_version",
    "arms",
    "score_deltas",
    "cost_deltas",
    "answer_text_deltas"
  ],
  "properties": {
    "run_id": {"type": "string", "minLength": 1, "maxLength": 128, "description": "The run that wrote this artifact (the run envelope, #277). Optional: artifacts written before it have none."},
    "schema_version": {
      "const": "plugin_delta.v1"
    },
    "library_name": {
      "type": ["string", "null"]
    },
    "model": {
      "type": ["string", "null"]
    },
    "provider": {
      "type": ["string", "null"]
    },
    "harness": {
      "type": ["string", "null"]
    },
    "judge_model": {
      "type": ["string", "null"]
    },
    "judge_provider": {
      "type": ["string", "null"]
    },
    "baseline_plugin_set": {
      "type": ["string", "null"]
    },
    "baseline_plugin_set_id": {
      "type": ["string", "null"]
    },
    "plugin_set": {
      "type": ["string", "null"]
    },
    "plugin_set_id": {
      "type": ["string", "null"]
    },
    "arms": {
      "type": "array",
      "items": {"type": "string"}
    },
    "total_questions": {
      "type": ["integer", "null"]
    },
    "score_deltas": {
      "type": "object"
    },
    "cost_deltas": {
      "type": "object"
    },
    "answer_text_deltas": {
      "type": "object"
    },
    "warnings": {
      "type": "array",
      "items": {"type": "string"}
    }
  }
}
