{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/intel/dokimi/schemas/repo_manifest.v1.json",
  "title": "Repository evaluation manifest v1",
  "description": "repo-eval.yaml: what a scanned repository provides so dokimi can evaluate it (docs/repo-evaluation-contract.md §2). This is an input the repository owns, not an artifact the framework writes, so it carries `schema` rather than `schema_version`. eval_dir, tasks and entry_points come together or not at all (dependentRequired here; dokimi/repos/manifest.py says so in friendlier words); without them the manifest is guidance-only, enough for `repo scan` and `repo reach` but not for running tasks. Paths are relative to the repository root; semantic rules (placeholders, path containment) are checked in dokimi/repos/manifest.py.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "guidance"],
  "dependentRequired": {
    "eval_dir": ["tasks", "entry_points"],
    "tasks": ["eval_dir", "entry_points"],
    "entry_points": ["eval_dir", "tasks"],
    "image": ["eval_dir"],
    "explore_tasks": ["eval_dir"]
  },
  "properties": {
    "schema": {"const": "repo_manifest.v1"},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "url": {"type": "string", "minLength": 1}
      }
    },
    "eval_dir": {"type": "string", "minLength": 1},
    "guidance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["globs"],
      "properties": {
        "globs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "also_scan": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dockerfile"],
      "properties": {
        "dockerfile": {"type": "string", "minLength": 1},
        "caches": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "path"],
            "properties": {
              "name": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"},
              "path": {"type": "string", "pattern": "^/"}
            }
          }
        },
        "env": {
          "type": "object",
          "propertyNames": {"pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
          "additionalProperties": {"type": "string"}
        },
        "network": {"enum": ["none", "public"]}
      }
    },
    "entry_points": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "grade": {"type": "string", "minLength": 1},
        "oracle": {"type": "string", "minLength": 1},
        "static": {"type": "string", "minLength": 1}
      }
    },
    "tasks": {"type": "string", "minLength": 1},
    "explore_tasks": {"type": ["string", "null"]},
    "build_systems": {
      "type": "array",
      "uniqueItems": true,
      "items": {"enum": ["bazel", "make", "cmake", "pytest", "pre-commit"]}
    },
    "process_metrics": {
      "type": "object",
      "propertyNames": {"pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
      "additionalProperties": {
        "oneOf": [
          {"type": "string", "minLength": 1},
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["regex"],
            "properties": {
              "regex": {"type": "string", "minLength": 1},
              "match": {"enum": ["text", "output", "any"]}
            }
          }
        ]
      }
    }
  }
}
