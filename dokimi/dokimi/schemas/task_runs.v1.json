{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/intel/dokimi/schemas/task_runs.v1.json",
  "title": "Executable task-run artifact v1",
  "type": "object",
  "required": [
    "schema_version",
    "harnesses",
    "tasks",
    "results",
    "summary"
  ],
  "properties": {
    "schema_version": {
      "const": "task_runs.v1"
    },
    "generated_at": {
      "type": "string"
    },
    "model": {
      "type": [
        "string",
        "null"
      ]
    },
    "baseline_harness": {
      "type": [
        "string",
        "null"
      ]
    },
    "harnesses": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "repeats": {
      "type": "integer",
      "minimum": 1
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "path",
          "metadata",
          "verifier",
          "agent",
          "environment"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "metadata": {
            "type": "object"
          },
          "verifier": {
            "type": "object"
          },
          "agent": {
            "type": "object"
          },
          "environment": {
            "type": "object"
          }
        }
      }
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "task",
          "harness",
          "passed",
          "metrics",
          "operations"
        ],
        "properties": {
          "task": {
            "type": "string"
          },
          "harness": {
            "type": "string"
          },
          "command": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "returncode": {
            "type": "integer"
          },
          "elapsed_sec": {
            "type": "number"
          },
          "model": {
            "type": [
              "string",
              "null"
            ]
          },
          "passed": {
            "type": "boolean"
          },
          "reward": {
            "type": [
              "number",
              "null"
            ]
          },
          "stdout_tail": {
            "type": "string"
          },
          "stderr_tail": {
            "type": "string"
          },
          "output_dir": {
            "type": [
              "string",
              "null"
            ]
          },
          "repeat": {
            "type": "integer",
            "minimum": 1
          },
          "metrics": {
            "type": "object",
            "required": [
              "operation_count",
              "operations_by_type"
            ],
            "properties": {
              "dry_run": {
                "type": "boolean"
              },
              "timeout_sec": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "stdout_bytes": {
                "type": "integer",
                "minimum": 0
              },
              "stderr_bytes": {
                "type": "integer",
                "minimum": 0
              },
              "operation_count": {
                "type": "integer",
                "minimum": 0
              },
              "operations_by_type": {
                "type": "object",
                "additionalProperties": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "n_skill_invocations": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0,
                "description": "Invocations of the arm's treatment skill in this row's trajectory (not every skill loaded). Where a harness deploys a root of packs (benchflow-*), every pack in that root is treatment, a distractor placed there included. Written only by harnesses that can see skill use (null when they could not count); feeds summary skill_invocation_rate."
              },
              "skill_notice": {
                "type": "boolean",
                "description": "Skill arms of the docker-claude family: whether the prompt opened with the treatment notice (false on the -skill-discover arms, which install the same skill and leave finding it to its description)."
              },
              "skill_listing": {
                "type": "object",
                "description": "Skill listing metrics for -skill and -skill-discover arms: description length budget and truncation status.",
                "properties": {
                  "description_chars": {
                    "type": "integer",
                    "minimum": 0,
                    "description": "Number of characters in the skill description."
                  },
                  "max_desc_chars": {
                    "type": "integer",
                    "minimum": 0,
                    "description": "Maximum allowed description characters."
                  },
                  "budget_chars": {
                    "type": "integer",
                    "minimum": 0,
                    "description": "Total character budget for the listing."
                  },
                  "truncated": {
                    "type": "boolean",
                    "description": "Whether the skill description was truncated to fit the budget."
                  }
                },
                "additionalProperties": true
              },
              "exploration_metrics": {
                "type": "object",
                "description": "Optional exploration-quality block. Emitted only when the operation stream contains read/search/subagent/edit signal. Metrics that cannot be derived from the available telemetry are null.",
                "additionalProperties": true
              }
            },
            "additionalProperties": true
          },
          "operations": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "type",
                "name",
                "status",
                "elapsed_sec",
                "metadata"
              ],
              "properties": {
                "type": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "status": {
                  "type": "string"
                },
                "elapsed_sec": {
                  "type": "number"
                },
                "metadata": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "per_harness",
        "comparisons"
      ],
      "properties": {
        "per_harness": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "n",
              "passed",
              "elapsed_sec",
              "operation_count",
              "operations_by_type",
              "pass_rate",
              "avg_reward"
            ],
            "properties": {
              "n": {
                "type": "integer",
                "minimum": 0
              },
              "passed": {
                "type": "integer",
                "minimum": 0
              },
              "elapsed_sec": {
                "type": "number"
              },
              "operation_count": {
                "type": "integer",
                "minimum": 0
              },
              "operations_by_type": {
                "type": "object",
                "additionalProperties": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "pass_rate": {
                "type": [
                  "number",
                  "null"
                ],
                "description": "passed / scored; null when no cell was scored.",
                "minimum": 0,
                "maximum": 1
              },
              "avg_reward": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "cost": {
                "type": "object",
                "description": "Rolled-up LLM telemetry; total_cost_usd is null when no call was priced.",
                "properties": {
                  "total_cost_usd": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "cost_known_n": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "cost_per_pass_usd": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "description": "total_cost_usd / passed, only when every row (errored rows included) carries metrics.cost_usd and at least one passed. Null otherwise: today a runner-errored row (no cost_usd) or an agent timeout whose result was never parsed nulls it for the whole arm."
                  }
                },
                "additionalProperties": true
              },
              "per_task": {
                "type": "object",
                "description": "Per-task pass breakdown for this harness.",
                "additionalProperties": {
                  "type": "object",
                  "required": [
                    "n",
                    "passed",
                    "pass_rate"
                  ],
                  "properties": {
                    "n": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "passed": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "pass_rate": {
                      "type": [
                        "number",
                        "null"
                      ],
                      "description": "passed / (n - errored); null when no cell was scored.",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "errored": {
                      "type": "integer",
                      "minimum": 0
                    }
                  }
                }
              },
              "errored": {
                "type": "integer",
                "minimum": 0,
                "description": "Cells whose harness raised (metrics.error): no verdict. Excluded from pass_rate."
              },
              "scored": {
                "type": "integer",
                "minimum": 0,
                "description": "n - errored: the denominator of pass_rate."
              },
              "pass_rate_ci": {
                "type": "object",
                "description": "Wilson score interval on pass_rate over the scored rows (errored rows excluded, as in pass_rate). Assumes independent rows, so with repeats > 1 it is too narrow.",
                "properties": {
                  "lo": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "minimum": 0,
                    "maximum": 1
                  },
                  "hi": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "minimum": 0,
                    "maximum": 1
                  },
                  "confidence": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "exclusiveMaximum": 1
                  },
                  "method": {
                    "enum": [
                      "wilson"
                    ]
                  }
                },
                "required": [
                  "lo",
                  "hi",
                  "confidence",
                  "method"
                ]
              },
              "skill_invocation_rate": {
                "type": [
                  "number",
                  "null"
                ],
                "description": "Share of the rows that report metrics.n_skill_invocations (errored rows excluded) in which it is > 0. The key counts invocations of the treatment skill only. Null when no row reports it. Rows marked metrics.solver_error are not errored, so they count here if they report the key.",
                "minimum": 0,
                "maximum": 1
              },
              "skill_invocation_n": {
                "type": "integer",
                "minimum": 0,
                "description": "Rows behind skill_invocation_rate: non-errored rows that report metrics.n_skill_invocations."
              }
            }
          }
        },
        "comparisons": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "baseline_harness",
              "pass_rate_delta",
              "passed_delta",
              "operation_count_delta"
            ],
            "properties": {
              "baseline_harness": {
                "type": "string"
              },
              "pass_rate_delta": {
                "type": [
                  "number",
                  "null"
                ],
                "description": "Null when the two arms lost different cells to harness errors: an arm with fewer verdicts would otherwise look different for reasons other than the treatment. Cells both arms lost cancel out. mcnemar pairs only cells both arms scored."
              },
              "passed_delta": {
                "type": [
                  "integer",
                  "null"
                ],
                "description": "Null under the same rule as pass_rate_delta."
              },
              "operation_count_delta": {
                "type": "integer"
              },
              "cost_delta_usd": {
                "type": [
                  "number",
                  "null"
                ],
                "description": "Null when either arm's cost is unknown, or under the same rule as pass_rate_delta."
              },
              "mcnemar": {
                "type": [
                  "object",
                  "null"
                ],
                "description": "Paired significance on the binary pass/fail outcomes, per (task, repeat) cell against the baseline harness. McNemar's exact test: only the discordant cells carry evidence. Null when no cell is shared with the baseline. p_exact and significant are null when there is no discordant pair at all — no evidence either way, as distinct from evidence of no difference. p_adjusted is Holm-corrected across the non-baseline harnesses in the same sweep.",
                "properties": {
                  "test": {
                    "const": "mcnemar_exact"
                  },
                  "n": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "n_gained": {
                    "type": "integer",
                    "minimum": 0,
                    "description": "Cells this harness passed and the baseline failed."
                  },
                  "n_lost": {
                    "type": "integer",
                    "minimum": 0,
                    "description": "Cells the baseline passed and this harness failed."
                  },
                  "n_both_passed": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "n_both_failed": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "n_discordant": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "n_excluded": {
                    "type": "integer",
                    "minimum": 0,
                    "description": "Cells dropped from the pairing, measured against every cell either harness attempted: present for one harness only, or the harness errored."
                  },
                  "n_units": {
                    "type": "integer",
                    "minimum": 0,
                    "description": "Independent units behind the n pairs (the distinct tasks). Equals n when repeats is 1."
                  },
                  "pseudo_replicated": {
                    "type": "boolean",
                    "description": "True when n_units < n, i.e. repeats were paired as separate cells. McNemar assumes independent pairs, so p_exact is then anti-conservative."
                  },
                  "paired_pass_rate_delta": {
                    "type": "number",
                    "description": "(n_gained - n_lost) / n over the shared cells, as a fraction. Distinct from the sibling pass_rate_delta, which subtracts two marginal pass rates over every row each harness ran."
                  },
                  "ci_lo": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "ci_hi": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "ci_confidence": {
                    "type": "number"
                  },
                  "p_exact": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "p_adjusted": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "correction": {
                    "type": "string"
                  },
                  "correction_family": {
                    "const": "harnesses",
                    "description": "Names the hypothesis family these p-values were corrected within. The judged track's arm and interaction families are corrected separately, so the multiplier here counts harnesses only."
                  },
                  "family_size": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "significant": {
                    "type": [
                      "boolean",
                      "null"
                    ]
                  },
                  "significant_adjusted": {
                    "type": [
                      "boolean",
                      "null"
                    ]
                  }
                },
                "additionalProperties": true
              },
              "errored": {
                "type": "integer",
                "minimum": 0
              },
              "baseline_errored": {
                "type": "integer",
                "minimum": 0
              },
              "normalized_gain": {
                "type": [
                  "number",
                  "null"
                ],
                "maximum": 1,
                "description": "Hake's (pass_rate - base) / (1 - base), as SkillsBench uses it: the share of the baseline's headroom gained. Equals SkillsBench's per-configuration value only when every cell scored and rewards are binary. Unbounded below (0.5 vs 0.95 is -9); read regressions from normalized_change. Null when the baseline passes everything, or under the same rule as pass_rate_delta (the arms' errored cells differ)."
              },
              "normalized_change": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": -1,
                "maximum": 1,
                "description": "The Marx & Cummings (2007) piecewise formula applied to aggregate pass rates, in [-1, 1]: equals normalized_gain for a gain; a loss is (pass_rate - base) / base, the share of the baseline's passes lost; 0 when the rates are equal. The halves are on different scales, so compare sign and bounds, not magnitudes across signs. Null when both rates are 0 or both 1 (M&C drop that case), or under the same rule as pass_rate_delta (the arms' errored cells differ)."
              }
            }
          }
        },
        "discovery_gaps": {
          "type": "object",
          "description": "Per -skill-discover arm run beside its with-skill arm (same launch and skill): gap = with-skill pass rate - discovery pass rate. Present only when such a pair ran.",
          "additionalProperties": {
            "type": "object",
            "required": [
              "with_skill_harness",
              "gap"
            ],
            "properties": {
              "with_skill_harness": {
                "type": "string"
              },
              "with_skill_pass_rate": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "maximum": 1
              },
              "discover_pass_rate": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "maximum": 1
              },
              "gap": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": -1,
                "maximum": 1,
                "description": "Null when the two arms lost different cells, or one has none scored."
              },
              "with_skill_invocation_rate": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "maximum": 1
              },
              "discover_invocation_rate": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "maximum": 1
              }
            }
          }
        }
      }
    }
  }
}
