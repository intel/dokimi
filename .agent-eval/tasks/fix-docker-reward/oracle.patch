+@pytest.mark.parametrize("rc", [0, 1])
+def test_docker_verify_reads_reward_json_over_the_exit_code(tmp_path, monkeypatch, rc):
+    """Harbor verifiers may write only reward.json, and exit 0 on a fail."""
+    import dokimi.harnesses.docker_solver as mod
+    from dokimi.harnesses.docker_solver import DockerSolverHarness
+
+    class _P:
+        def __init__(self, returncode):
+            self.returncode, self.stdout = returncode, "true"
+
+    def _docker(args, log, **kwargs):
+        if args[0] == "cp" and args[1].endswith("/logs/verifier/reward.json"):
+            Path(args[2]).write_text('{"reward": 0.0, "answer_present": 0.0}', encoding="utf-8")
+            return _P(0)
+        if args[0] == "cp" and args[1].endswith("/logs/verifier/reward.txt"):
+            return _P(1)
+        return _P(rc if args[0] == "exec" else 0)
+
+    monkeypatch.setattr(mod, "_docker", _docker)
+    out = tmp_path / "o"
+    out.mkdir()
+    task = load_task(_harbor(tmp_path))
+    assert DockerSolverHarness(harness_id="docker-oracle", mode="oracle")._verify(task, "c1", out, log=None) == 0.0
+
