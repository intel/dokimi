+def _in_range(value: float) -> float | None:
+    return value if 0.0 <= value <= 1.0 else None
+
+
+def _json_reward(text: str) -> float | None:
+    """The ``reward`` key of a Harbor ``reward.json`` (``{"reward": 0.0, ...}``)."""
+    try:
+        data = json.loads(text)
+    except ValueError:
+        return None
+    value = data.get("reward") if isinstance(data, dict) else None
+    if isinstance(value, bool) or not isinstance(value, (int, float)) or math.isnan(value):
+        return None
+    return _in_range(float(value))
+
+
+def _labelled_reward(text: str) -> float | None:
+    """A ``reward: x`` (or ``score``/``pass_rate``) in [0, 1]; a ``reward`` label
+    wins over the others wherever it appears."""
+    found: dict[bool, float | None] = {}
+    for match in _REWARD_RE.finditer(text):
+        found.setdefault(match.group(1).lower() == "reward", _in_range(float(match.group(2))))
+    if True in found:
+        return found[True]
+    return found.get(False)
 
 
