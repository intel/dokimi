--- /dev/null
+++ b/examples/toy-repo/src/tinycalc/tokens.py
@@ -0,0 +1,57 @@
+"""Tokenize and parse an expression into a tree of tuples."""
+
+import re
+
+_TOKEN = re.compile(r"\s*(?:(\d+(?:\.\d*)?)|(.))")
+
+
+def tokenize(text):
+    """Numbers as floats, operators and parentheses as one-character strings."""
+    out = []
+    for number, op in _TOKEN.findall(text):
+        if number:
+            out.append(float(number))
+        elif op.strip():
+            out.append(op)
+    return out
+
+
+def parse(text):
+    """``"1 + 2 * 3"`` -> ``("+", 1.0, ("*", 2.0, 3.0))``."""
+    tokens = tokenize(text)
+    pos = 0
+
+    def peek():
+        return tokens[pos] if pos < len(tokens) else None
+
+    def take():
+        nonlocal pos
+        pos += 1
+        return tokens[pos - 1]
+
+    def expr():
+        node = term()
+        while peek() in ("+", "-"):
+            node = (take(), node, term())
+        return node
+
+    def term():
+        node = factor()
+        while peek() in ("*", "/"):
+            node = (take(), node, factor())
+        return node
+
+    def factor():
+        tok = take()
+        if tok == "(":
+            node = expr()
+            take()
+            return node
+        if tok == "-":
+            return ("neg", factor())
+        return tok
+
+    tree = expr()
+    if peek() is not None:
+        raise ValueError(f"unexpected {peek()!r}")
+    return tree
