+"""``tinycalc EXPR``: print the value of an arithmetic expression."""
+
+import sys
+
+from .evaluate import calc
+
+
+def main(argv=None):
+    args = sys.argv[1:] if argv is None else argv
+    if len(args) != 1:
+        print("usage: tinycalc EXPR", file=sys.stderr)
+        return 2
+    value = calc(args[0])
+    print(int(value) if value.is_integer() else value)
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
