+from tinycalc.tokens import parse, tokenize
+
+
+def test_tokenize():
+    assert tokenize("2*(3.5+4)") == [2.0, "*", "(", 3.5, "+", 4.0, ")"]
+
+
+def test_parse():
+    assert parse("1 + 2 * 3") == ("+", 1.0, ("*", 2.0, 3.0))
