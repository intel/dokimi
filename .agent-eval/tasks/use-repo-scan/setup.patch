@@ -0,0 +1,24 @@
+"""Evaluate a tree from :func:`tinycalc.tokens.parse`."""
+
+from .tokens import parse
+
+_OPS = {
+    "+": lambda a, b: a + b,
+    "-": lambda a, b: a - b,
+    "*": lambda a, b: a * b,
+    "/": lambda a, b: a / b,
+}
+
+
+def evaluate(node):
+    if isinstance(node, float):
+        return node
+    if node[0] == "neg":
+        return -evaluate(node[1])
+    op, left, right = node
+    return _OPS[op](evaluate(left), evaluate(right))
+
+
+def calc(text):
+    """``calc("2 * (3 + 4)") == 14.0``."""
+    return evaluate(parse(text))
