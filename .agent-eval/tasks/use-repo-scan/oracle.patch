+# dokimi manifest for an L0 scan of this repository's agent guidance:
+#   python cli.py repo scan <path-to-toy-repo> --manifest repo-eval.yaml
+# eval_dir, entry_points and tasks are required by repo_manifest.v1 and unused by a scan
+# (`repo validate` would refuse this file: the repository has no evaluation tasks).
+schema: repo_manifest.v1
+id: tinycalc
+eval_dir: .agent-eval
+guidance:
+  globs: ["**/AGENTS.md"]
+  also_scan: ["AGENTS.md", "README.md"]
+entry_points: {grade: "true"}
+tasks: .agent-eval/tasks
+build_systems: [make, pytest]
