+    @property
+    def digest(self) -> str:
+        """sha256 of what the task is scored on: its query and its references.
+
+        Recorded with every run, so two runs compare the same version of a task only when
+        their digests match. Key order and whitespace in the YAML do not change it; a
+        reference added, moved or re-ranged does.
+        """
+        canonical = json.dumps(
+            {"query": self.query, "references": [r.as_dict() for r in self.references]},
+            sort_keys=True, separators=(",", ":"),
+        )
+        return hashlib.sha256(canonical.encode("utf-8")).hexdigest()
+
     def as_dict(self) -> dict:
         return {
             "id": self.id,
             "product": self.product,
             "query": self.query,
