diff --git a/dokimi/tests/test_condition_labels.py b/dokimi/tests/test_condition_labels.py
new file mode 100644
index 0000000..cce43f1
--- /dev/null
+++ b/dokimi/tests/test_condition_labels.py
@@ -0,0 +1,70 @@
+# Copyright (C) 2026 Intel Corporation
+# SPDX-License-Identifier: Apache-2.0
+
+"""User-facing output names the two answer conditions "treatment" and "control".
+
+The stored data keeps its ``with_docs`` / ``without_docs`` keys; only what a reader sees
+changes, so these tests feed the renderers data in the stored shape.
+"""
+
+from __future__ import annotations
+
+import json
+import types
+
+from dokimi.commands import baseline as baseline_cmd
+from dokimi.commands.benchmark import _resolved_benchmark_plan
+from dokimi.report.eval_report import generate_report
+
+
+def _eval_data():
+    def ev(qid, w, wo):
+        return {"question_id": qid, "question_text": f"{qid}?", "difficulty": "beginner",
+                "with_docs": {"aggregate": w}, "without_docs": {"aggregate": wo}, "delta": w - wo}
+    return {"schema_version": "eval.v1", "evaluations": [ev("q1", 80.0, 60.0), ev("q2", 50.0, 70.0)]}
+
+
+def _header_cells(md):
+    lines = md.splitlines()
+    return [
+        cell.strip()
+        for i, line in enumerate(lines[:-1])
+        if line.startswith("|") and set(lines[i + 1].replace("|", "").strip()) <= set("-: ")
+        and lines[i + 1].startswith("|")
+        for cell in line.strip("|").split("|")
+    ]
+
+
+def test_eval_report_tables_use_treatment_and_control(tmp_path, capsys):
+    src = tmp_path / "eval.json"
+    src.write_text(json.dumps(_eval_data()), encoding="utf-8")
+    out = tmp_path / "r.md"
+    generate_report(str(src), str(out))
+    cells = _header_cells(out.read_text(encoding="utf-8"))
+    assert "Treatment" in cells and "Control" in cells
+    assert not [c for c in cells if "Baseline" in c or c.startswith("Context")]
+    assert "treatment=65.0, control=65.0" in capsys.readouterr().out
+
+
+def test_baseline_commands_use_treatment_and_control(tmp_path, monkeypatch, capsys):
+    monkeypatch.setattr(baseline_cmd, "BASELINES_DIR", tmp_path / "baselines")
+    src = tmp_path / "eval.json"
+    src.write_text(json.dumps(_eval_data()), encoding="utf-8")
+    baseline_cmd.cmd_baseline_save(types.SimpleNamespace(from_eval=str(src), product="p", name="b"))
+    baseline_cmd.cmd_baseline_list(types.SimpleNamespace(product=None))
+    baseline_cmd.cmd_baseline_compare(types.SimpleNamespace(eval=str(src), product="p", baseline="b"))
+    out = capsys.readouterr().out
+    assert "treatment=65.0  control=65.0" in out
+    assert "treatment" in out.splitlines()[2] and "control" in out.splitlines()[2]
+    assert "Treatment avg" in out and "Control avg" in out
+    assert "Baseline avg" not in out and "Context avg" not in out
+    # the manifest keeps its stored keys, so baselines saved earlier still compare
+    manifest = json.loads((tmp_path / "baselines" / "manifest.json").read_text(encoding="utf-8"))
+    assert manifest["baselines"][0]["summary"]["avg_with"] == 65.0
+
+
+def test_benchmark_plan_names_the_conditions():
+    entry = types.SimpleNamespace(key="k", name="n", description="d", repo="r", doc_sources=["context7"])
+    args = types.SimpleNamespace(provider="openai", model="m", judge_provider="anthropic", judge_model="j")
+    arms = _resolved_benchmark_plan(entry, args)["arms"]
+    assert "treatment" in arms and "control" in arms and "with_docs" not in arms
