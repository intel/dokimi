diff --git a/dokimi/tests/test_grounding.py b/dokimi/tests/test_grounding.py
index 8e33d56..5c70ba0 100644
--- a/dokimi/tests/test_grounding.py
+++ b/dokimi/tests/test_grounding.py
@@ -5,7 +5,7 @@
 
 from __future__ import annotations
 
-from dokimi.eval.grounding import evaluate_grounding, grounding_score
+from dokimi.eval.grounding import annotate_answers, evaluate_grounding, grounding_score
 from dokimi.eval.stats import bootstrap_ci
 
 
@@ -62,3 +62,24 @@ def test_bootstrap_ci_interval_brackets_mean():
     vals = [0.2, 0.4, 0.6, 0.8]
     ci = bootstrap_ci(vals, seed=3)
     assert ci["lo"] <= ci["mean"] <= ci["hi"]
+
+
+def _ans(qid, answer, n_ctx, baseline="unsure"):
+    docs = [{"snippet": f"parallel_for runs tasks {i}"} for i in range(n_ctx)]
+    return {"question_id": qid, "with_docs": {"answer": answer, "retrieved_docs": docs},
+            "without_docs": {"answer": baseline}}
+
+
+def test_evaluate_grounding_min_contexts():
+    answers = [_ans("q1", "use parallel_for", 1), _ans("q2", "use parallel_for", 3)]
+    result = evaluate_grounding(answers, min_contexts=2)
+    assert [p["question_id"] for p in result["per_question"]] == ["q2"]
+
+
+def test_annotate_answers_lift():
+    out = annotate_answers([_ans("q1", "parallel_for runs", 2, baseline="parallel_for maybe")])
+    g = out[0]["grounding"]
+    assert g["score"] == 1.0
+    assert g["baseline_score"] == 0.5
+    assert g["lift"] == 0.5
+    assert out[0]["with_context"]["answer"] == "parallel_for runs"
