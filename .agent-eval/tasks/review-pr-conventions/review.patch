 dokimi/dokimi/commands/evaluate.py            | 15 ++++++-
 dokimi/dokimi/eval/grounding.py               | 43 +++++++++++++++++--
 dokimi/dokimi/schemas/answers.v1.json         | 13 +++++-
 dokimi/pyproject.toml                         |  1 +
 .../tests/fixtures/artifacts/answers.v1.json  |  6 +++
