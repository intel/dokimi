diff --git a/dokimi/tests/test_code_block_lang.py b/dokimi/tests/test_code_block_lang.py
new file mode 100644
index 0000000..8a2cb3b
--- /dev/null
+++ b/dokimi/tests/test_code_block_lang.py
@@ -0,0 +1,30 @@
+# Copyright (C) 2026 Intel Corporation
+# SPDX-License-Identifier: Apache-2.0
+
+"""Tests for the code_block_lang static metric."""
+
+from __future__ import annotations
+
+from dokimi.metrics import code_block_lang
+
+
+def test_empty_text_scores_zero():
+    assert code_block_lang.score("") == 0.0
+
+
+def test_no_blocks_scores_one():
+    assert code_block_lang.score("# Title\n\nJust prose.\n") == 1.0
+
+
+def test_share_of_labelled_blocks():
+    text = "```bash\nls\n```\n\n```\nplain\n```\n\n~~~python\nx = 1\n~~~\n\n```\nmore\n```\n"
+    assert code_block_lang.score(text) == 0.5
+
+
+def test_fence_inside_longer_fence_is_content():
+    text = "````markdown\n```\ninner\n```\n````\n"
+    assert code_block_lang.score(text) == 1.0
+
+
+def test_unclosed_block_counts():
+    assert code_block_lang.score("```\nno close\n") == 0.0
