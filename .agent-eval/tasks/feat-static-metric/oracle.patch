new file mode 100644
index 0000000..ac0e2b9
--- /dev/null
+++ b/dokimi/dokimi/metrics/code_block_lang.py
@@ -0,0 +1,39 @@
+# Copyright (C) 2026 Intel Corporation
+# SPDX-License-Identifier: Apache-2.0
+
+"""Share of fenced code blocks that declare a language (```bash, not a bare ```)."""
+
+from __future__ import annotations
+
+import re
+
+# An opening or closing fence: up to three spaces of indent, then ``` or ~~~ (3+),
+# then the info string. The first word of the info string is the language.
+FENCE_RE = re.compile(r"^ {0,3}(`{3,}|~{3,})(.*)$")
+
+
+def score(text: str) -> float:
+    """Return the fraction of fenced code blocks whose opening fence names a language.
+
+    ``0.0`` for empty input; ``1.0`` when the document has no fenced blocks (nothing to
+    label). An unclosed block at the end of the text still counts.
+    """
+    if not text.strip():
+        return 0.0
+    blocks = labelled = 0
+    fence: str | None = None
+    for line in text.splitlines():
+        m = FENCE_RE.match(line)
+        if not m:
+            continue
+        marker, info = m.group(1), m.group(2).strip()
+        if fence is None:
+            fence = marker
+            blocks += 1
+            if info:
+                labelled += 1
+        elif marker[0] == fence[0] and len(marker) >= len(fence) and not info:
+            fence = None
+    if blocks == 0:
+        return 1.0
+    return round(labelled / blocks, 4)
