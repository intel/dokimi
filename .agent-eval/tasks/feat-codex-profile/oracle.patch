diff --git a/dokimi/dokimi/repos/profiles/codex.yaml b/dokimi/dokimi/repos/profiles/codex.yaml
new file mode 100644
index 0000000..2458daf
--- /dev/null
+++ b/dokimi/dokimi/repos/profiles/codex.yaml
@@ -0,0 +1,57 @@
+schema: harness_profile.v1
+name: codex
+bin: codex
+version_cmd: ["{bin}", "--version"]
+# `codex exec` is the non-interactive mode: it prints progress on stderr and only the
+# final message on stdout, which the `text` trace takes as the answer. The prompt
+# comes last, after `--`, so a prompt that starts with "-" is never read as a flag.
+# Codex has no turn or spend cap on the command line: {max_turns} and {budget} are
+# not passed, and the run's timeout is the only bound.
+invoke:
+  - "{bin}"
+  - "exec"
+  - "--model"
+  - "{model}"
+  - "--ephemeral"
+  - "--skip-git-repo-check"
+  - "--ignore-user-config"
+  - "--color"
+  - "never"
+  - "{tools}"
+  - "--"
+  - "{prompt}"
+# Codex cannot switch tools off: `none` and `read` both get the read-only sandbox
+# (the agent can still read files and run read-only commands). `all` relies on the
+# framework's container for isolation.
+tools:
+  none: ["--sandbox", "read-only"]
+  read: ["--sandbox", "read-only"]
+  all: ["--dangerously-bypass-approvals-and-sandbox"]
+config_dir_env: CODEX_HOME
+env_allow:
+  - PATH
+  - HOME
+  - LANG
+  - SYSTEMROOT
+  - CODEX_API_KEY
+  - OPENAI_API_KEY
+  - OPENAI_BASE_URL
+  - http_proxy
+  - https_proxy
+  - no_proxy
+  - HTTP_PROXY
+  - HTTPS_PROXY
+  - NO_PROXY
+egress:
+  - api.openai.com
+endpoint_env: OPENAI_BASE_URL
+trace: text
+guidance:
+  names: [AGENTS.md, AGENTS.override.md]
+  resolution: codex-home + git-root-to-cwd
+  imports: null
+  notes: >-
+    Documented for codex-cli 0.160.0: one AGENTS.override.md or AGENTS.md per
+    directory from the git root down to the working directory, concatenated root
+    first; CLAUDE.md is not read. Not measured yet: the reach probe measures this
+    per version.
