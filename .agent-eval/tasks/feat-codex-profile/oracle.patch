+def test_builtin_codex_profile_runs_codex_exec_and_declares_agents_md(tmp_path):
+    profile = load_profile("codex")
+    prompt = '-say "hi"; {model}'
+    argv = profile.argv(prompt=prompt, model="gpt-5-codex", tools="none", bin_path="/opt/codex")
+    assert argv[:2] == ["/opt/codex", "exec"]
+    assert argv[-2:] == ["--", prompt]  # after "--": a leading "-" is not read as a flag
+    assert argv[argv.index("--model") + 1] == "gpt-5-codex"
+    assert argv[argv.index("--sandbox") + 1] == "read-only"
+    assert "--dangerously-bypass-approvals-and-sandbox" in profile.argv(prompt="p", model="m", tools="all")
+    assert "AGENTS.md" in profile.guidance_names and "CLAUDE.md" not in profile.guidance_names
+    assert profile.trace == "text" and profile.bridge is None
+    env = profile.env(tmp_path / "home", base={"PATH": "/bin", "OPENAI_API_KEY": "k", "AWS_REGION": "x"})
+    assert env["CODEX_HOME"] == str(tmp_path / "home") and env["OPENAI_API_KEY"] == "k"
+    assert "AWS_REGION" not in env
+
+
+def test_repo_reach_dry_run_with_the_codex_profile_probes_agents_md_only(tmp_path, capsys):
+    root = _repo(tmp_path)
+    args = build_parser().parse_args(["repo", "reach", str(root), "--manifest", "evals/repo-eval.yaml",
+                                      "--harness", "codex", "--model", "m", "--dry-run", "--scenarios", "root"])
+    args.func(args)
+    plan = json.loads(capsys.readouterr().out)
+    assert plan["files"] == [".github/instructions/c.md", "AGENTS.md", "sub/AGENTS.md"]
+    assert plan["runs"][0]["argv"][:2] == ["codex", "exec"]
+
