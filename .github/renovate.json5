// Dependency updates: the SHA-pinned actions in .github/workflows, the Python
// lock (dokimi/requirements.lock.txt), the tools lock the workflows and the eval
// image (.agent-eval/Dockerfile) install (dokimi/requirements-ci.lock.txt) and the
// hook revs in .pre-commit-config.yaml.
//
// Once a week, every minor and patch update lands in one PR; a major update
// gets a PR of its own. Advisories (vulnerabilityAlerts) skip the schedule.
// pep440 counts 0.x -> 0.y as minor, so those bumps go into the weekly PR too.
{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "config:recommended",
    ":semanticCommits",
    // Pin any new action to a SHA with the exact release in the trailing comment.
    "helpers:pinGitHubActionDigestsToSemver",
  ],
  schedule: ["* 0-3 * * 1"],
  timezone: "UTC",
  // The default of 2 PRs an hour would push some of the first run's PRs, and
  // the monthly lock refresh, past the 4-hour window.
  prHourlyLimit: 0,
  // An open PR changes only on Mondays, not on every run during the week.
  updateNotScheduled: false,
  // A release has to be a week old before it is proposed, so a compromised
  // or yanked tag has time to be noticed upstream. This covers only the
  // version proposed for a direct dependency; the lock refresh and the
  // transitive pins are held by --exclude-newer=P7D in the lock's header
  // command. Trade-off: a fix released less than 7 days ago does not resolve
  // in its vulnerability PR; regenerate the lock by hand without the flag.
  minimumReleaseAge: "7 days",
  labels: ["dependencies"],
  // Without this, the numpy/scipy rule below would drop their vulnerability
  // PRs too. enabled: true lets a security fix through a packageRules
  // enabled: false (as the security:only-security-updates preset does).
  vulnerabilityAlerts: { enabled: true },

  // The lock is a uv --universal compile of requirements.txt +
  // requirements-test.txt; the tools lock compiles requirements-ci.txt against
  // it. Both carry hashes (--generate-hashes in the header command). pip-compile
  // re-runs the command in its header with --upgrade-package, which keeps the
  // per-interpreter markers; pip_requirements would edit the pins in place without re-resolving, so it is left off.
  // pyproject.toml repeats the ranges of requirements.txt; pep621 keeps the two
  // in step when a range has to move (same dependency, same branch, one PR).
  // requirements-docs.lock.txt is not matched yet: its header is not uv's, and it
  // is compiled against the main lock with -c. pip-audit.yml audits it.
  enabledManagers: ["github-actions", "pip-compile", "pep621", "custom.regex", "pre-commit"],
  // Off by default even when listed above. It reads `rev: <sha>  # frozen: vX`
  // and updates the SHA and the tag together.
  "pre-commit": { enabled: true },
  "pip-compile": {
    managerFilePatterns: ["/(^|/)requirements(-ci)?\\.lock\\.txt$/"],
  },
  // Inside a range: bump the lock only. Outside it: move the range too.
  rangeStrategy: "update-lockfile",
  // Direct dependencies follow the weekly schedule; this refreshes the
  // transitive pins the lock carries.
  lockFileMaintenance: {
    enabled: true,
    schedule: ["* 0-3 1 * *"],
  },

  customManagers: [
    {
      // The gitleaks release gitleaks.yml downloads. Its SHA-256 has no
      // datasource: the bump PR fails that workflow until GITLEAKS_SHA256 is
      // updated by hand from the release's checksums file.
      customType: "regex",
      managerFilePatterns: ["/^\\.github/workflows/gitleaks\\.yml$/"],
      matchStrings: ["GITLEAKS_VERSION: '?(?<currentValue>\\d+\\.\\d+\\.\\d+)'?"],
      depNameTemplate: "gitleaks/gitleaks",
      datasourceTemplate: "github-releases",
      extractVersionTemplate: "^v(?<version>.+)$",
    },
    {
      // The micromamba release conda-forge.yml installs. Its tags carry a
      // build number (2.9.0-0), which semver would read as a prerelease.
      customType: "regex",
      managerFilePatterns: ["/^\\.github/workflows/conda-forge\\.yml$/"],
      matchStrings: ["micromamba-version: '?(?<currentValue>\\d+\\.\\d+\\.\\d+-\\d+)'?"],
      depNameTemplate: "mamba-org/micromamba-releases",
      datasourceTemplate: "github-releases",
      versioningTemplate: "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-(?<build>\\d+)$",
    },
  ],
  packageRules: [
    {
      groupName: "non-major dependencies",
      groupSlug: "non-major",
      matchUpdateTypes: ["minor", "patch", "pinDigest", "digest"],
    },
    {
      // A pre-commit hook and the pins the tools lock and the dev extra carry
      // for the same tool move in one PR, majors included, so the hook
      // never reports what CI does not (or the reverse). Later rules win, so these leave the non-major group.
      groupName: "ruff",
      groupSlug: "ruff",
      matchDepNames: ["ruff", "astral-sh/ruff-pre-commit"],
    },
    {
      groupName: "zizmor",
      groupSlug: "zizmor",
      matchDepNames: ["zizmor", "zizmorcore/zizmor-pre-commit"],
    },
    {
      // The pre-commit hook rev and gitleaks.yml's download (both depName
      // gitleaks/gitleaks).
      groupName: "gitleaks",
      groupSlug: "gitleaks",
      matchDepNames: ["gitleaks/gitleaks"],
    },
    {
      // Renovate pins the proposed release (--upgrade-package=numpy==X), and
      // the newest numpy and scipy need a newer Python than the lock's oldest
      // branch, so the uv run for the whole group would fail. The monthly
      // lock refresh re-resolves them per Python version instead.
      matchManagers: ["pip-compile"],
      matchPackageNames: ["numpy", "scipy"],
      matchUpdateTypes: ["minor", "patch"],
      enabled: false,
    },
    {
      matchManagers: ["github-actions", "pre-commit"],
      semanticCommitType: "ci",
    },
    {
      // The Python setup-python installs is a CI choice, not a dependency.
      matchManagers: ["github-actions"],
      matchDepNames: ["python"],
      enabled: false,
    },
    {
      // ragas 0.4 is a migration, not a bump (see SECURITY.md), and every
      // ragas release imports a module langchain-community 0.4.2 removed.
      matchDepNames: ["ragas"],
      allowedVersions: "<0.4",
    },
    {
      matchDepNames: ["langchain-community"],
      allowedVersions: "<0.4.2",
    },
    {
      // litellm (up to 1.105.1) requires openai<3; v3 resolves to an
      // old, vulnerable litellm. Lift once litellm accepts openai 3.
      matchDepNames: ["openai"],
      allowedVersions: "<3",
    },
  ],
}
